{
  "info": {
    "name": "express-project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "studentId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"status is OK\", () => pm.expect(pm.response.json().status).to.eql(\"OK\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Rehan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rehan"
      }
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create student (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"returns the student\", () => pm.expect(pm.response.json()).to.include({ name: \"rahul\", class: \"cse\" }));",
                  "pm.test(\"has dob field\", () => pm.expect(pm.response.json()).to.have.property(\"dob\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{studentId}}\",\n  \"name\": \"rahul\",\n  \"class\": \"cse\",\n  \"dob\": \"2002-05-15\"\n}"
            },
            "url": "{{baseUrl}}/students"
          }
        },
        {
          "name": "Get all students (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students"
          }
        },
        {
          "name": "Get one student (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the right id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"studentId\"))));",
                  "pm.test(\"has dob field\", () => pm.expect(pm.response.json()).to.have.property(\"dob\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Replace student (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"class is ece\", () => pm.expect(pm.response.json().class).to.eql(\"ece\"));",
                  "pm.test(\"has dob field\", () => pm.expect(pm.response.json()).to.have.property(\"dob\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{studentId}}\",\n  \"name\": \"rahul\",\n  \"class\": \"ece\",\n  \"dob\": \"2002-05-15\"\n}"
            },
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Update student (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"class is cse\", () => pm.expect(pm.response.json().class).to.eql(\"cse\"));",
                  "pm.test(\"has dob field\", () => pm.expect(pm.response.json()).to.have.property(\"dob\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class\": \"cse\",\n  \"dob\": \"2000-08-20\"\n}"
            },
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Delete student (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the deleted student\", () => pm.expect(pm.response.json()).to.have.property(\"deleted\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        }
      ]
    }
  ]
}
