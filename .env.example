# Copy this file to .env and put your real value in .env (never share .env)
# Supabase dashboard -> your project -> Connect -> "Direct connection" -> copy the URI
# and replace [YOUR-PASSWORD] with your database password.
# If the direct connection fails on your network (it needs IPv6), use the "Session pooler" URI instead.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

PORT=3000
